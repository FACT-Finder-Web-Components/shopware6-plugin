{% sw_extends '@Parent/storefront/layout/header/search.html.twig' %}


{% block layout_header_search %}
  {% if ff_disable_webc() %}
    {{ parent() }}
  {% else %}
    <div class="collapse" id="searchCollapse">
      <div class="header-search">
        <div class="header-search-form">
          {% block layout_header_search_input_group %}
            <div class="input-group">
              {% block layout_header_search_input %}
                {% if ff_disable_webc() %}
                  {{ parent() }}
                {% else %}
                  <ff-searchbox
                    suggest-onfocus="true"
                    use-suggest="true"
                    select-onclick="true"
                    {% if page.extensions.factfinder.features.usePopularSearches %} popular-searches {% endif %}
                  >
                    {{ parent() }}
                  </ff-searchbox>
                {% endif %}
              {% endblock %}

              {% block layout_header_search_button %}
                {% if ff_disable_webc() %}
                  {{ parent() }}
                {% else %}
                  <ff-searchbutton class="input-group-append">
                    {{ parent() }}
                  </ff-searchbutton>
                {% endif %}
              {% endblock %}

              {% block layout_header_close_button %}
                {% if ff_disable_webc() %}
                  <button class="btn header-close-btn js-search-close-btn d-none"
                          type="button"
                          aria-label="{{ 'header.searchCloseButton'|trans|striptags }}">
                            <span class="header-close-icon">
                                {% sw_icon 'x' %}
                            </span>
                  </button>
                {% endif %}
              {% endblock %}
            </div>
          {% endblock %}

          {% sw_include '@Parent/storefront/layout/factfinder/suggest.html.twig' %}
        </div>
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block factfinder_module_ui_feed_export %}
  <sw-card-view deprecated>

    <sw-card deprecated>
      <sw-container columns="repeat(auto-fit, minmax(250px, 1fr)" gap="0px 30px" deprecated>
        <sw-entity-single-select
          v-model:value ="salesChannelValue"
          entity="sales_channel"
          id="sales_channel"
          :label="$t('ui-feed-export.component.export_form.sales_channel.label')"
          deprecated>
        </sw-entity-single-select>

        <sw-entity-single-select
          v-model:value ="salesChannelLanguageValue"
          entity="language"
          id="sales_channel_language"
          :label="$t('ui-feed-export.component.export_form.sales_channel_language.label')"
          deprecated>
        </sw-entity-single-select>

        <sw-select-field id="export_type"
                         v-model:value ="exportTypeValue"
                         :label="$t('ui-feed-export.component.export_form.export_type.label')"
                         deprecated>
          <option v-for="(key, value) in typeSelectOptions" :value="value">
            {{ value }}
          </option>
        </sw-select-field>

      </sw-container>
      <sw-button @click="getFeedExportFile('_action/fact-finder/generate-feed')"
                 :isLoading="isLoadingExport"
                 :disabled="isLoadingExport"
                 variant="success"
                 block="true"
                 size="large"
                 deprecated>
        {{ $t('ui-feed-export.component.export_form.button.title') }}
      </sw-button>
    </sw-card>
  </sw-card-view>
{% endblock %}
